# ===========================================================================
# Karigar — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env.
# ===========================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Platform administrator (Django superuser) ---
# Created automatically on container boot if it does not already exist
# (idempotent). This is the SaaS operator who manages shops via /admin; it has
# no shop and is never affected by the subscription lock. Use a strong password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Database ---
# Local dev convenience only. Set to False everywhere else.
USE_SQLITE=False
DATABASE_URL=postgres://karigar:karigar@db:5432/karigar
POSTGRES_DB=karigar
POSTGRES_USER=karigar
POSTGRES_PASSWORD=karigar

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (backups) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@karigar.local

# --- Media / object storage (production) ---
# While USE_S3=False, uploaded photos are stored on the local filesystem.
# MEDIA_HOST is the host folder bind-mounted to /app/media (a plain folder, NOT
# a Docker volume — survives `docker compose down -v` and `docker volume prune`).
# Use an absolute path to keep media outside the repo, e.g. D:/KarigarMedia.
USE_S3=False
MEDIA_HOST=./media-files
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Backups (resilient, off-Docker-volume) ---
# Master key for encrypting backups. Generate with: manage.py backup_key
# Keep it in a secrets manager — NEVER commit it or store it in the DB.
BACKUP_ENCRYPTION_KEY=
# Host folder bind-mounted to /app/backups (a plain folder, NOT a Docker volume).
BACKUP_PRIMARY_HOST=./secure-backups
# Windows host path -> container mount map (JSON). Lets staff type Windows paths
# in the UI. Must be valid JSON (use {} if unused).
BACKUP_PATH_MAP={}
# App version stamped into backup manifests.
APP_GIT_SHA=dev

# --- Production hardening ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
# Cookie security. Keep True for real HTTPS prod. Set BOTH False only for a
# local HTTP run, otherwise the Django admin cannot keep a session over http://.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Origins trusted for admin login POSTs behind the proxy (comma-separated).
# e.g. https://admin.yourdomain.com  (or http://localhost:8080 for local HTTP)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Frontend (Vite build) ---
VITE_API_PROXY=http://localhost:8000
